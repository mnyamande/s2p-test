        <mxCell id="qiYp3C5U_6en0ntC8AVg-6" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;aspect=fixed;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;" value="6" vertex="1">
